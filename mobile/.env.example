# Copy to `.env` and fill in values. Never commit real secrets.
# EXPO_PUBLIC_* variables are embedded in the JS bundle at build time — never put secrets here.
# Always run `npm run start:clean` after changing this file.

# ── Backend URL ───────────────────────────────────────────────────────────────
# Local development:
# EXPO_PUBLIC_BACKEND_URL= 

# Physical device on the same Wi-Fi (replace with your machine's LAN IP):
# EXPO_PUBLIC_BACKEND_URL 

# EC2 deployment (direct IP):
# EXPO_PUBLIC_BACKEND_URL=http://your-ec2-ip:3000

# Production (HTTPS via load balancer or custom domain):
# EXPO_PUBLIC_BACKEND_URL=https://api.clarodoc.com

EXPO_PUBLIC_BACKEND_URL=http://localhost:4000

# ── EAS Build ─────────────────────────────────────────────────────────────────
# Required for `eas build`. Find your project ID at expo.dev → Project settings.
# EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
