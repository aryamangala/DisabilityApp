# Copy to `.env` and fill in values. Never commit real secrets.
# For EC2: set these in backend/.env on the instance (loaded by docker-compose.yml).

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production          # use "development" locally
PORT=4000

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=              # required — platform.openai.com/api-keys
# OPENAI_MODEL=gpt-4o        # optional override (default: gpt-4o)

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=                  # required — generate with: openssl rand -hex 32

# ── Password Reset Emails (Gmail SMTP) ───────────────────────────────────────
# Requires Gmail 2-Step Verification.
# Create App Password at: myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=          # 16-character app password (no spaces)

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local dev: use the Docker container values below.
# EC2 Docker Compose: DB_HOST is overridden to "db" by docker-compose.yml.
# Production RDS: set DB_HOST to your RDS endpoint and DB_SSL=true.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disabilityapp
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false                 # set to "true" for RDS with SSL

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# On EC2: credentials come from the IAM instance profile — no keys needed here.
# Locally: configure AWS CLI (aws configure) or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
AWS_REGION=us-east-1
S3_BUCKET_NAME=clara-doc

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to the origin(s) that your web frontend is served from.
# Comma-separated for multiple origins.
# Example: CORS_ORIGIN=http://your-ec2-ip,https://app.clarodoc.com
CORS_ORIGIN=

# ── Optional / Diagnostics ───────────────────────────────────────────────────
# LOG_VERBOSE=true            # verbose HTTP + OpenAI tracing
# ALLOW_DIAGNOSTICS=true      # enables /test-openai endpoint (never in production)
